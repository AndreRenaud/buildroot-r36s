#!/bin/sh
#
# Set the default playback volume. The RK817 codec comes up at 0 dB, which is
# painfully loud on the R36S speaker; 175/255 (-29.8 dB) is comfortable.
# Runs before the user app (S12userapp) starts making sound.
# Silent until the user app sets its own level: r36s-menu restores the one
# chosen with the volume buttons.
#

VOLUME=0

case "$1" in
	start)
		echo "Setting volume to $VOLUME..."
		amixer -q sset Master $VOLUME
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
