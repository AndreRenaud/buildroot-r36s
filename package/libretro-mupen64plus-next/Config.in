config BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT
	bool "libretro-mupen64plus-next"
	depends on !BR2_STATIC_LIBS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBGLES
	help
	  Mupen64Plus-Next, a Nintendo 64 emulator, as a libretro
	  core.

	  Installs /usr/lib/libretro/mupen64plus_next_libretro.so.

	  https://github.com/libretro/mupen64plus-libretro-nx

comment "libretro-mupen64plus-next needs an OpenGL ES and EGL backend, a toolchain w/ C++, threads, dynamic library"
	depends on BR2_STATIC_LIBS || !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_HAS_THREADS || !BR2_PACKAGE_HAS_LIBEGL || \
		!BR2_PACKAGE_HAS_LIBGLES
